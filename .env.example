# AWS credentials (admin or least-privilege role - see README.md)
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-west-2

# Optional: Session token when using temporary credentials from assumed role
# AWS_SESSION_TOKEN=your-session-token

# Optional: Use an existing VPC instead of creating a new one
# VPC_ID=vpc-xxxxxxxx

# Optional: Update policy for an existing deployment
# DEPLOYMENT_ID=your-deployment-id
