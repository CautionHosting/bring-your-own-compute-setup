# AWS credentials with admin permissions (used only during setup)
AWS_ACCESS_KEY_ID=your-admin-key
AWS_SECRET_ACCESS_KEY=your-admin-secret
AWS_REGION=us-west-2

# Optional: Use an existing VPC instead of creating a new one
# VPC_ID=vpc-xxxxxxxx

# Optional: Update policy for an existing deployment
# DEPLOYMENT_ID=your-deployment-id
